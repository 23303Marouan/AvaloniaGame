<!-- Views/MainWindow.axaml -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MonJeu.ViewModels"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="MonJeu.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        
        Title="MonJeu">

    <Grid ColumnDefinitions="180,*">
      <!-- Menu de Navigation -->
      <StackPanel Grid.Column="0" Margin="8" Spacing="8">
        
        <Button Background="Transparent"
                BorderThickness="0"
                Padding="10"
                Command="{Binding NavigateToHomeCommand}">
          <ic:FluentIcon Icon="Home"
                   IconVariant="Regular"
                   FontSize="28"/>         
        </Button>
       
        <Button Background="Transparent"
                BorderThickness="0"
                Padding="10"
                Command="{Binding NavigateToSettingsCommand}">
          <ic:FluentIcon Icon="Settings"
                   IconVariant="Regular"
                   FontSize="28"/>         
        </Button>
        
        <Button Content="Choisir le niveau" Command="{Binding NavigateToLevelsCommand}" HorizontalAlignment="Stretch"/>
        
      </StackPanel>

      <!-- Zone de contenu principale à droite -->
      <Border Grid.Column="1" Margin="0,8,8,8" CornerRadius="8" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <ContentControl Content="{Binding CurrentViewModel}" Margin="10"/>
      </Border>
    </Grid>
</Window>